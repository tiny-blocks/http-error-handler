{
    "name": "tiny-blocks/http-error-handler",
    "description": "PSR-15 error handler that maps thrown exceptions to structured JSON error responses with optional logging.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "http",
        "psr-15",
        "tiny-blocks",
        "observability",
        "error-handling",
        "exception-mapping"
    ],
    "authors": [
        {
            "name": "Gustavo Freze de Araujo Santos",
            "homepage": "https://github.com/gustavofreze"
        }
    ],
    "homepage": "https://github.com/tiny-blocks/http-error-handler",
    "support": {
        "issues": "https://github.com/tiny-blocks/http-error-handler/issues",
        "source": "https://github.com/tiny-blocks/http-error-handler"
    },
    "require": {
        "php": "^8.5",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "tiny-blocks/http": "^7.1",
        "tiny-blocks/http-correlation-id": "^2.1"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.52",
        "guzzlehttp/psr7": "^3.0",
        "infection/infection": "^0.34",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.2",
        "sentry/sentry": "^4.0",
        "slevomat/coding-standard": "^8.31",
        "slim/slim": "^4.15",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "suggest": {
        "sentry/sentry": "Required to use SentryReporter (^4.0)."
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "TinyBlocks\\Http\\ErrorHandler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\TinyBlocks\\Http\\ErrorHandler\\Unit\\": "tests/Unit/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true
        },
        "process-timeout": 0,
        "sort-packages": true
    },
    "scripts": {
        "configure": [
            "@composer install --optimize-autoloader",
            "@composer normalize"
        ],
        "configure-and-update": [
            "@composer update --optimize-autoloader",
            "@composer normalize"
        ],
        "review": [
            "@php ./vendor/bin/phpcs --standard=phpcs.xml --extensions=php ./src ./tests",
            "@php ./vendor/bin/phpstan analyse -c phpstan.neon.dist --quiet --no-progress"
        ],
        "test-file": "@php ./vendor/bin/phpunit --configuration phpunit.xml --no-coverage --filter",
        "tests": [
            "@php -d memory_limit=2G ./vendor/bin/phpunit --configuration phpunit.xml tests",
            "@php ./vendor/bin/infection --threads=max --logger-html=reports/coverage/mutation-report.html --coverage=reports/coverage"
        ]
    }
}
